@model EventosUnison.Models.ViewModels.ProyectosIndexViewModel
@{
    ViewData["Title"] = "Proyectos";

    string Tamano(long? bytes)
    {
        if (bytes == null) return "";
        return bytes >= 1024 * 1024
            ? $"{bytes / 1048576.0:0.0} MB"
            : $"{Math.Max(1, bytes.Value / 1024)} KB";
    }

    string Iniciales(string? nombre) => string.Concat(
        (nombre ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
}

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success">@TempData["Exito"]</div>
}

<div class="pagina-cab">
    <p class="text-muted mb-0">Proyectos académicos compartidos por la comunidad.</p>
    <a asp-action="Publicar" class="btn btn-primary">➕ Publicar proyecto</a>
</div>

<form asp-action="Index" method="get" class="row g-2 align-items-center mb-4">
    <div class="col-md-6">
        <div class="input-group input-futurista">
            <span class="input-group-text" aria-hidden="true">🔍</span>
            <input type="text" name="q" value="@Model.Q" class="form-control"
                   placeholder="Buscar por nombre, descripción, responsable, carrera o departamento" />
        </div>
    </div>
    <div class="col-auto">
        <div class="form-check form-switch mb-0">
            <input type="checkbox" role="switch" name="mios" value="true" id="mios" class="form-check-input"
            @(Model.Mios ? "checked" : "") />
            <label class="form-check-label" for="mios">Solo mis proyectos</label>
        </div>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
    </div>
</form>

@if (!Model.Proyectos.Any())
{
    <div class="vacio">
        <div class="vacio-icono">🧪</div>
        <h5>No se encontraron proyectos</h5>
        <p>Prueba con otra búsqueda o publica el tuyo.</p>
        <a asp-action="Publicar" class="btn btn-primary">Publicar un proyecto</a>
    </div>
}
else
{
    <p class="text-muted small">@Model.Proyectos.Count @(Model.Proyectos.Count == 1 ? "proyecto" : "proyectos")</p>

    <div class="row g-3">
        @foreach (var p in Model.Proyectos)
        {
            <div class="col-md-6 col-xl-4">
                <article class="card proy-card h-100">
                    <div class="card-body d-flex flex-column">
                        <h5 class="mb-2">@p.Nombre</h5>
                        <p class="text-muted small desc-clamp mb-3" title="@p.Descripcion">@p.Descripcion</p>

                        <div class="d-flex flex-wrap gap-1 mb-3">
                            @if (!string.IsNullOrEmpty(p.Carrera))
                            {
                                <span class="etiqueta">📚 @p.Carrera</span>
                            }
                            <span class="etiqueta">🏛 @p.Departamento</span>
                        </div>

                        <div class="mt-auto">
                            @if (!string.IsNullOrEmpty(p.ArchivoRuta))
                            {
                                <a asp-action="Descargar" asp-route-id="@p.Id" class="btn btn-outline-primary btn-sm">
                                    📎 @p.ArchivoNombre <span class="text-muted">(@Tamano(p.ArchivoTamano))</span>
                                </a>
                            }

                            <div class="pie-proy d-flex align-items-center gap-2">
                                <div class="avatar-mini">@Iniciales(p.Usuario?.NombreCompleto)</div>
                                <div class="lh-sm">
                                    <div class="fw-semibold">@p.Usuario?.NombreCompleto</div>
                                    <small class="text-muted">
                                        <span class="badge bg-secondary">@p.Usuario?.Rol</span>
                                        · @p.FechaDePublicacion.ToString("dd/MM/yyyy")
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}