@model EventosUnison.Models.ViewModels.AsistenciaViewModel
@{
    ViewData["Title"] = "Asistencia al evento";

    string Iniciales(string? nombre) => string.Concat(
        (nombre ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));

    string TextoRespuesta(string r) => r == "Si" ? "Sí" : "Tal vez";

    var registradosQueAsistieron = Model.Registrados.Where(r => r.Asistio == true).ToList();
    var interesadosQueAsistieron = Model.Interesados.Where(i => i.Asistio == true).ToList();
}

<div class="card mb-2">
    <div class="card-body">
        <div class="row g-3 align-items-center">
            <div class="col-lg-9">
                <partial name="_EventoInfo" model="Model.Evento" />
            </div>
            <div class="col-lg-3 text-lg-end">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Volver al panel</a>
            </div>
        </div>
    </div>
</div>

@* ============ 1. REGISTRADOS ============ *@
<h4 class="seccion-sub" id="registrados">
    Registrados
    <span class="badge bg-secondary">@Model.Registrados.Count</span>
</h4>

@if (!Model.Registrados.Any())
{
    <div class="vacio">
        <div class="vacio-icono">📋</div>
        <p class="mb-0">Nadie se ha registrado a este evento todavía.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Persona</th>
                    <th>Carrera / Departamento</th>
                    <th class="text-end">Asistencia</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reg in Model.Registrados)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar-mini">@Iniciales(reg.Usuario?.NombreCompleto)</div>
                                <div class="lh-sm">
                                    <div class="fw-semibold">@reg.Usuario?.NombreCompleto</div>
                                    <small class="text-muted">@reg.Usuario?.CorreoInstitucional</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(reg.Usuario?.Carrera))
                            {
                                <div>@reg.Usuario.Carrera</div>
                            }
                            <small class="text-muted">@reg.Usuario?.Departamento</small>
                        </td>
                        <td class="text-end text-nowrap">
                            <form asp-action="MarcarAsistencia" method="post" class="d-inline">
                                <input type="hidden" name="registroId" value="@reg.Id" />
                                <input type="hidden" name="eventoId" value="@Model.Evento?.Id" />
                                <button type="submit" name="asistio" value="true"
                                        class="btn btn-sm @(reg.Asistio == true ? "btn-success" : "btn-outline-success")">
                                    ✔ Asistió
                                </button>
                                <button type="submit" name="asistio" value="false"
                                        class="btn btn-sm @(reg.Asistio == false ? "btn-danger" : "btn-outline-danger")">
                                    ✖ No asistió
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
        
@* ============ 2. INTERESADOS (SÍ / TAL VEZ) ============ *@
<h4 class="seccion-sub" id="interesados">
    Interesados
    <span class="badge bg-secondary">@Model.Interesados.Count</span>
</h4>
<p class="text-muted small">Personas que respondieron Sí o Tal vez y no se registraron.</p>

@if (!Model.Interesados.Any())
{
    <div class="vacio">
        <div class="vacio-icono">⭐</div>
        <p class="mb-0">No hay interesados (Sí o Tal vez) sin registro para este evento.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Persona</th>
                    <th>Interés</th>
                    <th class="text-end">Asistencia</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var interes in Model.Interesados)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar-mini">@Iniciales(interes.Usuario?.NombreCompleto)</div>
                                <div class="lh-sm">
                                    <div class="fw-semibold">@interes.Usuario?.NombreCompleto</div>
                                    <small class="text-muted">@interes.Usuario?.CorreoInstitucional</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="estado estado-@(interes.Respuesta.ToLower())">@TextoRespuesta(interes.Respuesta)</span>
                        </td>
                        <td class="text-end text-nowrap">
                            <form asp-action="MarcarAsistenciaInteresado" method="post" class="d-inline">
                                <input type="hidden" name="interesId" value="@interes.Id" />
                                <input type="hidden" name="eventoId" value="@Model.Evento?.Id" />
                                <button type="submit" name="asistio" value="true"
                                        class="btn btn-sm @(interes.Asistio == true ? "btn-success" : "btn-outline-success")">
                                    ✔ Asistió
                                </button>
                                <button type="submit" name="asistio" value="false"
                                        class="btn btn-sm @(interes.Asistio == false ? "btn-danger" : "btn-outline-danger")">
                                    ✖ No asistió
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* ============ 3. LISTA DE ASISTENCIA (puedes borrar este bloque si no la quieres) ============ *@
<h4 class="seccion-sub">Lista de asistencia</h4>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">Registrados que asistieron</h5>
                    <span class="badge bg-success">@registradosQueAsistieron.Count</span>
                </div>

                @if (!registradosQueAsistieron.Any())
                {
                    <p class="text-muted small mb-0">Todavía no hay asistentes marcados en este grupo.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0 d-grid gap-3">
                        @foreach (var reg in registradosQueAsistieron)
                        {
                            <li class="d-flex align-items-center gap-2">
                                <div class="avatar-mini">@Iniciales(reg.Usuario?.NombreCompleto)</div>
                                <div class="lh-sm">
                                    <div class="fw-semibold">@reg.Usuario?.NombreCompleto</div>
                                    <small class="text-muted">@(string.IsNullOrEmpty(reg.Usuario?.Carrera) ? reg.Usuario?.Departamento : reg.Usuario?.Carrera)</small>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">Interesados que asistieron</h5>
                    <span class="badge bg-success">@interesadosQueAsistieron.Count</span>
                </div>

                @if (!interesadosQueAsistieron.Any())
                {
                    <p class="text-muted small mb-0">Todavía no hay asistentes marcados en este grupo.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0 d-grid gap-3">
                        @foreach (var interes in interesadosQueAsistieron)
                        {
                            <li class="d-flex align-items-center gap-2">
                                <div class="avatar-mini">@Iniciales(interes.Usuario?.NombreCompleto)</div>
                                <div class="lh-sm flex-grow-1">
                                    <div class="fw-semibold">@interes.Usuario?.NombreCompleto</div>
                                    <small class="text-muted">@interes.Usuario?.Departamento</small>
                                </div>
                                <span class="estado estado-@(interes.Respuesta.ToLower())">@TextoRespuesta(interes.Respuesta)</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>