<section class="hero">
    <div class="row align-items-center g-5">
        <div class="col-lg-7">
            <span class="chip">Universidad de Sonora</span>
            <h1 class="hero-title">
                Eventos y proyectos <span class="text-gradient">universitarios</span>, en un solo lugar.
            </h1>
            <p class="hero-lead">
                Una plataforma para la comunidad universitaria: descubre eventos académicos, tecnológicos,
                culturales y científicos, comparte tus proyectos y registra tu interés en participar.
            </p>
            <div class="d-flex gap-2 flex-wrap">
                <a class="btn btn-primary btn-lg" asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a>
                <a class="btn btn-outline-primary btn-lg" asp-controller="Cuenta" asp-action="Registro">Crear cuenta</a>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="logo-orbita">
                <img src="~/img/logo-unison.png" alt="Escudo de la Universidad de Sonora" />
            </div>
        </div>
    </div>
</section>

<section class="seccion">
    <h2 class="seccion-titulo">¿Qué puedes hacer aquí?</h2>
    <div class="row g-3">
        <div class="col-md-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="icono">📅</div>
                    <h5>Descubre eventos</h5>
                    <p class="text-muted mb-0">Consulta los eventos confirmados con fecha, lugar y organizador, y responde si te interesan.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="icono">🚀</div>
                    <h5>Propón el tuyo</h5>
                    <p class="text-muted mb-0">Alumnos, profesores y organizaciones pueden proponer eventos; un administrador los revisa.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="icono">🧪</div>
                    <h5>Comparte proyectos</h5>
                    <p class="text-muted mb-0">Publica tus proyectos académicos con un archivo adjunto y conoce los de tus compañeros.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="icono">🏆</div>
                    <h5>Suma Culturest</h5>
                    <p class="text-muted mb-0">Cada evento otorga 0.25 puntos Culturest. Revisa en qué eventos te has registrado.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="seccion">
    <h2 class="seccion-titulo">Desarrollador</h2>
    <div class="card">
        <div class="card-body d-flex flex-wrap align-items-center gap-4">
            <div class="avatar-dev">ME</div>
            <div>
                <h4 class="mb-1">Manuel Enriquez Grijalva</h4>
                <p class="text-muted mb-2">Desarrollador del proyecto</p>
                <p class="mb-0">
                    Plataforma creada con ASP.NET Core MVC, Entity Framework Core y SQL Server,
                    como parte del reto de programación <em>Gestión de eventos universitarios</em>.
                </p>
            </div>
        </div>
    </div>
</section>