@using System.Globalization
@model List<EventosUnison.Models.ViewModels.EventoItemViewModel>
@{
    ViewData["Title"] = "Eventos disponibles";
    var es = CultureInfo.GetCultureInfo("es-MX");
    var opciones = new[] { ("Si", "Me interesa"), ("TalVez", "Tal vez"), ("No", "No me interesa") };
}

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success">@TempData["Exito"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <p class="text-muted mb-0">
        @Model.Count @(Model.Count == 1 ? "evento próximo" : "eventos próximos") · confirmados por la administración
    </p>
    <input type="search" id="filtroEventos" class="form-control" style="max-width: 300px"
           placeholder="Buscar evento, lugar u organizador…" />
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay eventos próximos por el momento.</div>
}

<div class="row g-3">
    @foreach (var item in Model)
    {
        var e = item.Evento;
        var texto = $"{e.Nombre} {e.Descripcion} {e.Lugar} {e.Organizador} {e.Departamento}".ToLowerInvariant();

        <div class="col-xl-6 evento-col" data-texto="@texto">
            <article class="card evento-card h-100">
                <div class="card-body d-flex flex-column">
                    <partial name="_EventoInfo" model="e" />

                    <div class="mt-auto pt-3">
                        <div class="evento-acciones d-flex flex-wrap align-items-center gap-2">
                            @if (item.EsOrganizador)
                            {
                                <span class="estado estado-proximo">Tu evento</span>
                                <a asp-action="Interesados" asp-route-id="@e.Id" class="btn btn-outline-primary btn-sm">Ver interesados</a>
                            }
                            else
                            {
                                <form asp-action="ResponderInteres" method="post">
                                    <input type="hidden" name="id" value="@e.Id" />
                                    <div class="btn-group btn-group-sm" role="group">
                                        @foreach (var (valor, textoBoton) in opciones)
                                        {
                                            var activo = item.MiRespuesta == valor;
                                            <button type="submit" name="respuesta" value="@valor"
                                                    class="btn @(activo ? "btn-primary" : "btn-outline-primary")">
                                                @textoBoton
                                            </button>
                                        }
                                    </div>
                                </form>

                                @if (item.Registrado)
                                {
                                    <span class="badge bg-success">Registrado ✔</span>
                                }
                                else
                                {
                                    <form asp-action="Registrarme" method="post">
                                        <input type="hidden" name="id" value="@e.Id" />
                                        <button type="submit" class="btn btn-success btn-sm">Registrarme</button>
                                    </form>
                                }
                            }
                        </div>
                    </div>
                </div>
            </article>
        </div>
    }
</div>

@section Scripts {
    <script>
        const filtro = document.getElementById('filtroEventos');
        filtro.addEventListener('input', function () {
            const q = filtro.value.trim().toLowerCase();
            document.querySelectorAll('.evento-col').forEach(function (c) {
                c.hidden = q !== '' && !c.dataset.texto.includes(q);
            });
        });
    </script>
}