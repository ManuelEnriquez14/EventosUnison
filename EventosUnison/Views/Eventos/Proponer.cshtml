@model EventosUnison.Models.ViewModels.ProponerEventoViewModel
@{
    ViewData["Title"] = "Proponer evento";
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body p-4">
                <form asp-action="Proponer" method="post">
                    <div asp-validation-summary="ModelOnly"></div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label"></label>
                        <div class="input-group input-futurista">
                            <span class="input-group-text" aria-hidden="true">🎯</span>
                            <input asp-for="Nombre" class="form-control" />
                        </div>
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="4"
                                  data-contador="descContador" data-max="500"></textarea>
                        <div class="d-flex justify-content-between">
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                            <small class="text-muted ms-auto" id="descContador"></small>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FechaHora" class="form-label"></label>
                            <div class="input-group input-futurista">
                                <span class="input-group-text" aria-hidden="true">🕒</span>
                                <input asp-for="FechaHora" class="form-control" />
                            </div>
                            <span asp-validation-for="FechaHora" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Lugar" class="form-label"></label>
                            <div class="input-group input-futurista">
                                <span class="input-group-text" aria-hidden="true">📍</span>
                                <input asp-for="Lugar" class="form-control" />
                            </div>
                            <span asp-validation-for="Lugar" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Departamento" class="form-label"></label>
                            <div class="input-group input-futurista">
                                <span class="input-group-text" aria-hidden="true">🏛</span>
                                <input asp-for="Departamento" class="form-control" />
                            </div>
                            <span asp-validation-for="Departamento" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Organizador" class="form-label"></label>
                            <div class="input-group input-futurista">
                                <span class="input-group-text" aria-hidden="true">👤</span>
                                <input asp-for="Organizador" class="form-control" />
                            </div>
                            <span asp-validation-for="Organizador" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="form-text mb-4">
                        El organizador puede ser tu nombre o una organización, por ejemplo "Sociedad de Alumnos de Sistemas".
                    </div>

                    <button type="submit" class="btn btn-primary">Enviar propuesta</button>
                    <a asp-action="MisPropuestas" class="btn btn-outline-secondary">Cancelar</a>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h5 class="mb-3">¿Cómo funciona?</h5>
                <ol class="pasos">
                    <li><span>Envías tu propuesta con los datos del evento.</span></li>
                    <li><span>Un administrador la revisa y la confirma o la rechaza.</span></li>
                    <li><span>Si se confirma, aparece en la lista de eventos y la comunidad puede mostrar interés y registrarse.</span></li>
                </ol>
                <hr />
                <p class="small text-muted mb-0">
                    Cada evento otorga <strong class="text-gradient">+@EventosUnison.Models.Culturest.PuntosPorEvento pts Culturest</strong>.
                    Podrás ver el estado y los interesados en <a asp-action="MisPropuestas">Mis propuestas</a>.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}